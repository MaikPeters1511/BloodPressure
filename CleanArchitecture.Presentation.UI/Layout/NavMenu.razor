@using CleanArchitecture.Presentation.UI.Services
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject AuthSession Session
@inject NotificationCounter Counter
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@L["App_Title"]</a>
        <button type="button" class="navbar-toggler" aria-label="@L["Nav_Menu"]" aria-expanded="@(!collapseNavMenu ? "true" : "false")" aria-controls="main-nav" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon" aria-hidden="true"></span>
        </button>
    </div>
</div>

<div id="main-nav" class="@NavMenuCssClass nav-scrollable" @onclick="CollapseNavMenu">
    <nav class="flex-column" aria-label="@L["Nav_Menu"]">
        <div class="nav-item px-3">
            <NavLink class="btn btn-ghost text-xl" href="" Match="NavLinkMatch.All">@L["Nav_Home"]</NavLink>
        </div>
        @if (Session.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="btn btn-ghost text-xl" href="measurements">@L["Nav_Measurements"]</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="btn btn-ghost text-xl" href="statistics">@L["Nav_Statistics"]</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="btn btn-ghost text-xl" href="export">@L["Nav_Export"]</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="btn btn-ghost text-xl" href="reminders">@L["Nav_Reminders"]</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="btn btn-ghost text-xl" href="notifications">
                    @L["Nav_Notifications"]
                    @if (Counter.Unread > 0)
                    {
                        <span class="badge text-bg-danger unread-count" aria-label="@(Counter.Unread == 1 ? L["Nav_UnreadAriaOne"].Value : L["Nav_UnreadAria", Counter.Unread].Value)">@Counter.Unread</span>
                    }
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <button type="button" class="btn btn-ghost text-xl" @onclick="SignOutAsync">@L["Nav_Logout"]</button>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="btn btn-ghost text-xl" href="login">@L["Nav_Login"]</NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        Session.Changed += OnSessionChangedRefresh;
        Counter.Changed += OnSessionChanged;
        if (Session.IsAuthenticated)
        {
            await Counter.RefreshAsync();
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private async Task OnSignedInAsync()
    {
        if (Session.IsAuthenticated)
        {
            await Counter.RefreshAsync();
        }
        else
        {
            Counter.Set(0);
        }
    }

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    // Auf schmalen Bildschirmen schließt ein Klick auf einen Eintrag das Menü wieder.
    private void CollapseNavMenu() => collapseNavMenu = true;

    private async Task SignOutAsync()
    {
        await Session.LogoutAsync();
        Navigation.NavigateTo("login");
    }

    private void OnSessionChangedRefresh() => _ = InvokeAsync(OnSignedInAsync);

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Session.Changed -= OnSessionChangedRefresh;
        Counter.Changed -= OnSessionChanged;
    }
}
