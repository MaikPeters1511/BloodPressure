@page "/notifications"
@using System.Globalization
@using System.Net
@using CleanArchitecture.Contracts
@using CleanArchitecture.Presentation.UI.Services
@using Microsoft.Extensions.Localization
@using Refit
@inject ILanguageService Language
@inject INotificationApi Api
@inject NotificationCounter Counter
@inject AuthSession Session
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject IStringLocalizer<SharedResource> L
@inject ILogger<Notifications> Logger

<PageTitle>@L["Notifications_Title"]</PageTitle>

<h1>@L["Notifications_Title"]</h1>
<p class="text-muted">@L["Disclaimer_Medical"]</p>

@if (_message is not null)
{
    <div role="alert" class="alert alert-warning">@_message</div>
}

<section aria-busy="@(_loading ? "true" : "false")">
    @if (!_loading && _message is null && _items.Count == 0)
    {
        <p id="notifications-empty">@L["Notifications_Empty"]</p>
    }
    <p role="status" id="notifications-status" class="visually-hidden">@_status</p>
    <ul class="list-unstyled">
        @foreach (var n in _items)
        {
            var critical = n.Type == "CriticalReading";
            var time = TimeZoneInfo.ConvertTimeFromUtc(n.CreatedAt.ToUniversalTime(), Time.LocalTimeZone).ToString("g", Language.Culture);
            <li @key="n.Id" tabindex="-1" @ref="_refs[n.Id]" class="card mb-2 notification @(n.IsRead ? "read" : "unread") @(critical ? "border-danger" : "")">
                <div class="card-body" role="@(critical && !n.IsRead ? "alert" : null)">
                    <p class="mb-1">
                        <strong>@(critical ? L["Notifications_Warning"] : L["Notifications_Reminder"])</strong>
                        @if (n.Category is not null)
                        {
                            <CategoryBadge Category="@n.Category" Class="ms-2" />
                        }
                        @if (!n.IsRead)
                        {
                            <span class="badge text-bg-primary ms-2">@L["Notifications_New"]</span>
                        }
                    </p>
                    <p class="mb-1">@MessageText(n)</p>
                    <p class="mb-2 text-muted small">@time</p>
                    @if (!n.IsRead)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm mark-read"
                                aria-label="@L["Notifications_MarkReadAria", time]" @onclick="() => MarkReadAsync(n)">@L["Notifications_MarkRead"]</button>
                    }
                </div>
            </li>
        }
    </ul>
</section>

@code {
    private IReadOnlyList<NotificationDto> _items = [];
    private bool _loading = true;
    private string? _message;
    private string? _status;
    private Guid? _focusId;
    private readonly Dictionary<Guid, ElementReference> _refs = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("login");
            return;
        }

        try
        {
            _items = (await Api.GetAllAsync()).OrderByDescending(n => n.CreatedAt).ToList();
            Counter.Set(_items.Count(n => !n.IsRead));
        }
        catch (ApiException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            await Session.SignOutToLoginAsync(Navigation);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Hinweise konnten nicht geladen werden");
            _message = L["Error_Generic"].Value;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusId is { } id && _refs.TryGetValue(id, out var element))
        {
            _focusId = null;
            await element.FocusAsync();
        }
    }

    // Der Text kommt vom Server auf Deutsch; bekannte Typen werden in der Sprache der Oberfläche dargestellt.
    private string MessageText(NotificationDto n) => n.Type switch
    {
        "CriticalReading" => L["Notification_CriticalText", CategoryName(n.Category)].Value,
        "MeasurementReminder" => L["Notification_ReminderText"].Value,
        _ => n.Message
    };

    private string CategoryName(string? category)
    {
        var name = L[$"Category_{category ?? "Hypertension"}"];
        return name.ResourceNotFound ? category ?? "" : name.Value;
    }

    private async Task MarkReadAsync(NotificationDto notification)
    {
        _message = null;
        try
        {
            await Api.MarkAsReadAsync(notification.Id);
            _items = _items.Select(n => n.Id == notification.Id ? n with { IsRead = true } : n).ToList();
            Counter.Set(_items.Count(n => !n.IsRead));
            // Die Schaltfläche verschwindet; ohne Fokusziel ginge der Tastaturfokus verloren.
            _status = L["Notifications_MarkedRead"].Value;
            _focusId = notification.Id;
        }
        catch (ApiException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            await Session.SignOutToLoginAsync(Navigation);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Hinweis konnte nicht als gelesen markiert werden");
            _message = L["Error_Generic"].Value;
        }
    }
}
