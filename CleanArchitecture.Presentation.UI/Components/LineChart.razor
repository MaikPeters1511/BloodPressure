@using CleanArchitecture.Presentation.UI.Services

<figure class="line-chart">
    <svg viewBox="0 0 @W @H" role="img" aria-label="@AriaLabel" class="w-100">
        @for (var i = 0; i <= 4; i++)
        {
            var value = _min + (_max - _min) * i / 4;
            var y = ChartGeometry.Y(value, _min, _max, Top, PlotH);
            <line x1="@Left" x2="@(Left + PlotW)" y1="@Inv(y)" y2="@Inv(y)" stroke="currentColor" stroke-opacity="0.25" stroke-width="1" />
            @Label(Left - 6, y + 4, "end", Math.Round(value).ToString(System.Globalization.CultureInfo.InvariantCulture))
        }
        @foreach (var s in Series)
        {
            <polyline class="series" data-series="@s.Name" fill="none" stroke="@s.Color" stroke-width="2.5" stroke-dasharray="@s.Dash"
                      points="@ChartGeometry.Points(s.Values, _min, _max, Left, Top, PlotW, PlotH)" />
        }
        @if (Labels.Count > 0)
        {
            @Label(Left, H - 6, "start", Labels[0])
            @Label(Left + PlotW, H - 6, "end", Labels[^1])
        }
    </svg>
    <figcaption class="d-flex gap-3 flex-wrap mt-2">
        @foreach (var s in Series)
        {
            <span class="legend-item d-inline-flex align-items-center gap-2">
                <svg width="28" height="10" aria-hidden="true"><line x1="0" x2="28" y1="5" y2="5" stroke="@s.Color" stroke-width="2.5" stroke-dasharray="@s.Dash" /></svg>
                @s.Name
            </span>
        }
    </figcaption>
</figure>

@code {
    private const double W = 640, H = 260, Left = 40, Top = 10, PlotW = 580, PlotH = 210;
    private double _min, _max;

    public sealed record ChartSeries(string Name, IReadOnlyList<double> Values, string Color, string? Dash);

    [Parameter] public IReadOnlyList<ChartSeries> Series { get; set; } = [];
    [Parameter] public IReadOnlyList<string> Labels { get; set; } = [];
    [Parameter, EditorRequired] public string AriaLabel { get; set; } = "";

    protected override void OnParametersSet() => (_min, _max) = ChartGeometry.Range(Series.Select(s => s.Values));

    private static MarkupString Label(double x, double y, string anchor, string text)
        => new($"<text x=\"{Inv(x)}\" y=\"{Inv(y)}\" text-anchor=\"{anchor}\" font-size=\"11\" fill=\"currentColor\">{System.Net.WebUtility.HtmlEncode(text)}</text>");

    private static string Inv(double value) => value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
