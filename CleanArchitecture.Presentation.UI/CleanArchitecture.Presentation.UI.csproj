<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Für DE/EN-Kulturen im Browser (sonst invariante Globalisierung). -->
        <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.14" />
        <PackageReference Include="QRCoder" Version="1.8.1" />
        <PackageReference Include="Syncfusion.Blazor" Version="25.1.39" />
        <PackageReference Include="Syncfusion.Blazor.Grid" Version="25.1.39" />
        <PackageReference Include="Syncfusion.Blazor.Themes" Version="25.1.39" />
        <PackageReference Include="Syncfusion.Licensing" Version="25.1.39" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CleanArchitecture.Contracts\CleanArchitecture.Contracts.csproj" />
    </ItemGroup>

</Project>
