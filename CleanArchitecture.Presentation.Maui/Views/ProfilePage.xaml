<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CleanArchitecture.Presentation.Maui.Localization"
             xmlns:vm="clr-namespace:CleanArchitecture.Presentation.Maui.Core.ViewModels;assembly=CleanArchitecture.Presentation.Maui.Core"
             x:Class="CleanArchitecture.Presentation.Maui.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="{loc:Translate Profile_Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="560">
            <Label Text="{loc:Translate Profile_Title}" Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="{loc:Translate Theme_Title}" Style="{StaticResource SubHeadline}"
                   SemanticProperties.HeadingLevel="Level2" />
            <VerticalStackLayout Spacing="4">
                <RadioButton Content="{loc:Translate Theme_System}" GroupName="theme" IsChecked="{Binding IsThemeSystem}"
                             MinimumHeightRequest="44" AutomationId="ThemeSystem"
                             SemanticProperties.Description="{loc:Translate Theme_System}" />
                <RadioButton Content="{loc:Translate Theme_Light}" GroupName="theme" IsChecked="{Binding IsThemeLight}"
                             MinimumHeightRequest="44" AutomationId="ThemeLight"
                             SemanticProperties.Description="{loc:Translate Theme_Light}" />
                <RadioButton Content="{loc:Translate Theme_Dark}" GroupName="theme" IsChecked="{Binding IsThemeDark}"
                             MinimumHeightRequest="44" AutomationId="ThemeDark"
                             SemanticProperties.Description="{loc:Translate Theme_Dark}" />
            </VerticalStackLayout>
            <Label Text="{loc:Translate Theme_Hint}" FontSize="13" />

            <Label Text="{loc:Translate Language_Title}" Style="{StaticResource SubHeadline}"
                   SemanticProperties.HeadingLevel="Level2" />
            <VerticalStackLayout Spacing="4">
                <RadioButton Content="{loc:Translate Language_System}" GroupName="language" IsChecked="{Binding IsLanguageSystem}"
                             MinimumHeightRequest="44" AutomationId="LanguageSystem"
                             SemanticProperties.Description="{loc:Translate Language_System}" />
                <RadioButton Content="{loc:Translate Language_German}" GroupName="language" IsChecked="{Binding IsLanguageGerman}"
                             MinimumHeightRequest="44" AutomationId="LanguageGerman"
                             SemanticProperties.Description="{loc:Translate Language_German}" />
                <RadioButton Content="{loc:Translate Language_English}" GroupName="language" IsChecked="{Binding IsLanguageEnglish}"
                             MinimumHeightRequest="44" AutomationId="LanguageEnglish"
                             SemanticProperties.Description="{loc:Translate Language_English}" />
            </VerticalStackLayout>
            <Label Text="{loc:Translate Language_Hint}" FontSize="13" />

            <Label Text="{loc:Translate Profile_Personal}" Style="{StaticResource SubHeadline}"
                   SemanticProperties.HeadingLevel="Level2" />
            <Label Text="{Binding Hint}" FontSize="13" />

            <Label Text="{loc:Translate Profile_Age}" />
            <Entry Text="{Binding AgeText}" Keyboard="Numeric" AutomationId="AgeEntry" MinimumHeightRequest="44"
                   SemanticProperties.Description="{loc:Translate Profile_Age}" />
            <Label Text="{loc:Translate Profile_Height}" />
            <Entry Text="{Binding HeightText}" Keyboard="Numeric" AutomationId="HeightEntry" MinimumHeightRequest="44"
                   SemanticProperties.Description="{loc:Translate Profile_Height}" />
            <Label Text="{loc:Translate Profile_Weight}" />
            <Entry Text="{Binding WeightText}" Keyboard="Numeric" AutomationId="WeightEntry" MinimumHeightRequest="44"
                   SemanticProperties.Description="{loc:Translate Profile_Weight}" />

            <VerticalStackLayout MinimumHeightRequest="48" Spacing="2">
                <Label Text="{Binding BmiText}" FontAttributes="Bold" AutomationId="BmiLabel"
                       IsVisible="{Binding BmiText, Converter={StaticResource IsNotNullConverter}}" />
                <Label Text="{Binding BmiNote}" FontSize="13"
                       IsVisible="{Binding BmiText, Converter={StaticResource IsNotNullConverter}}" />
            </VerticalStackLayout>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Errors}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding .}" TextColor="{AppThemeBinding Light=#B02A37, Dark=#EA868F}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="{loc:Translate Form_Save}" Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    MinimumHeightRequest="44" AutomationId="SaveProfileButton" />
            <Button Text="{loc:Translate Profile_Delete}" Command="{Binding DeleteCommand}"
                    MinimumHeightRequest="44" Style="{StaticResource OutlineButton}" AutomationId="DeleteProfileButton" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource IsNotNullConverter}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
