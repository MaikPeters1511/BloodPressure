<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CleanArchitecture.Presentation.Maui.Localization"
             xmlns:vm="clr-namespace:CleanArchitecture.Presentation.Maui.Core.ViewModels;assembly=CleanArchitecture.Presentation.Maui.Core"
             x:Class="CleanArchitecture.Presentation.Maui.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="{loc:Translate Login_Title}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="480">
            <Label Text="{loc:Translate Login_Title}"
                   Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />

            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsCredentialsStep}" AutomationId="CredentialsPanel">
                <Label Text="{loc:Translate Login_Email}" x:Name="EmailLabel" />
                <Entry x:Name="EmailEntry"
                       Text="{Binding Email}"
                       Keyboard="Email"
                       AutomationId="EmailEntry"
                       MinimumHeightRequest="44"
                       SemanticProperties.Description="{loc:Translate Login_Email}" />

                <Label Text="{loc:Translate Login_Password}" />
                <Entry Text="{Binding Password}"
                       IsPassword="True"
                       AutomationId="PasswordEntry"
                       MinimumHeightRequest="44"
                       SemanticProperties.Description="{loc:Translate Login_Password}"
                       ReturnCommand="{Binding LoginCommand}" />
            </VerticalStackLayout>

            <!-- Zweiter Schritt: Code aus der Authenticator-App oder Wiederherstellungscode -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding RequiresTwoFactor}" AutomationId="TwoFactorPanel">
                <Label Text="{Binding CodeLabel}" />
                <Entry x:Name="AuthenticatorCodeEntry"
                       Text="{Binding TwoFactorCode}"
                       Keyboard="Numeric"
                       MaxLength="12"
                       IsVisible="{Binding ShowAuthenticatorCode}"
                       AutomationId="TwoFactorCodeEntry"
                       MinimumHeightRequest="44"
                       SemanticProperties.Description="{Binding CodeLabel}"
                       SemanticProperties.Hint="{Binding CodeHint}"
                       ReturnCommand="{Binding LoginCommand}" />
                <Entry x:Name="RecoveryCodeEntry"
                       Text="{Binding TwoFactorCode}"
                       Keyboard="Plain"
                       IsVisible="{Binding ShowRecoveryCode}"
                       AutomationId="RecoveryCodeEntry"
                       MinimumHeightRequest="44"
                       SemanticProperties.Description="{Binding CodeLabel}"
                       SemanticProperties.Hint="{Binding CodeHint}"
                       ReturnCommand="{Binding LoginCommand}" />
                <Label Text="{Binding CodeHint}" FontSize="13" />
                <Button Text="{Binding ToggleText}"
                        Command="{Binding ToggleRecoveryCodeCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        AutomationId="ToggleRecoveryButton"
                        MinimumHeightRequest="44"
                        Style="{StaticResource OutlineButton}" />
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                   TextColor="{AppThemeBinding Light=#B02A37, Dark=#EA868F}"
                   AutomationId="ErrorLabel" />

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasNotice}"
                                 AutomationId="NoticePanel">
                <Label Text="{Binding NoticeMessage}"
                       AutomationId="NoticeLabel"
                       SemanticProperties.Description="{Binding NoticeMessage}" />
                <Button Text="{loc:Translate Login_Resend}"
                        Command="{Binding ResendConfirmationCommand}"
                        IsVisible="{Binding ConfirmationPending}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        AutomationId="ResendButton"
                        MinimumHeightRequest="44"
                        Style="{StaticResource OutlineButton}"
                        SemanticProperties.Hint="{loc:Translate Login_ResendDescription}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="{loc:Translate Login_Submit}"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    AutomationId="LoginButton"
                    MinimumHeightRequest="44" />
            <Button Text="{loc:Translate Login_Register}"
                    Command="{Binding RegisterCommand}"
                    IsVisible="{Binding IsCredentialsStep}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    AutomationId="RegisterButton"
                    MinimumHeightRequest="44"
                    Style="{StaticResource OutlineButton}" />
            <Button Text="{loc:Translate Login_Back}"
                    Command="{Binding BackCommand}"
                    IsVisible="{Binding RequiresTwoFactor}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    AutomationId="BackButton"
                    MinimumHeightRequest="44"
                    Style="{StaticResource OutlineButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
