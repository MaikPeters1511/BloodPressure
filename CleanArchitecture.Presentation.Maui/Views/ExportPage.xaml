<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CleanArchitecture.Presentation.Maui.Localization"
             xmlns:vm="clr-namespace:CleanArchitecture.Presentation.Maui.Core.ViewModels;assembly=CleanArchitecture.Presentation.Maui.Core"
             x:Class="CleanArchitecture.Presentation.Maui.Views.ExportPage"
             x:DataType="vm:ExportViewModel"
             Title="{loc:Translate Export_Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="560">
            <Label Text="{loc:Translate Export_Title}" Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="{Binding Hint}" />

            <Label Text="{loc:Translate Export_Format}" />
            <Picker ItemsSource="{Binding FormatOptions}" SelectedIndex="{Binding SelectedFormat}"
                    MinimumHeightRequest="44" AutomationId="FormatPicker"
                    SemanticProperties.Description="{loc:Translate Export_Format}" />

            <HorizontalStackLayout Spacing="12">
                <Switch IsToggled="{Binding UseRange}" AutomationId="RangeSwitch"
                        SemanticProperties.Description="{loc:Translate Export_UseRange}" />
                <Label Text="{loc:Translate Export_UseRange}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="12" IsVisible="{Binding UseRange}">
                <Label Text="{loc:Translate Range_From}" />
                <DatePicker Date="{Binding FromDate}" MinimumHeightRequest="44"
                            SemanticProperties.Description="{loc:Translate Range_From}" />
                <Label Text="{loc:Translate Range_To}" />
                <DatePicker Date="{Binding ToDate}" MinimumHeightRequest="44"
                            SemanticProperties.Description="{loc:Translate Range_To}" />
            </VerticalStackLayout>

            <Button Text="{loc:Translate Export_Download}" Command="{Binding ExportCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    MinimumHeightRequest="44" AutomationId="ExportButton" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{loc:Translate Export_Busy}" IsVisible="{Binding IsBusy}" />

            <Label Text="{Binding Message}"
                   IsVisible="{Binding Message, Converter={StaticResource IsNotNullConverter}}"
                   TextColor="{AppThemeBinding Light=#B02A37, Dark=#EA868F}" />
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource IsNotNullConverter}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
